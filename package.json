{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
